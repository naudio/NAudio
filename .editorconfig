# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8-bom
indent_style = space
indent_size = 4
insert_final_newline = true

# C# files
[*.cs]
indent_size = 4

# =============================================================================
# C# code style preferences
#
# These document the conventions NAudio follows so the IDE steers
# contributors the same way. Severities live in .globalconfig (suggestion by
# default; the *enforced* rules are promoted to warning there). Do NOT add a
# ':severity' suffix to an option below: Roslyn lets an option's suffix
# override the rule's dotnet_diagnostic severity, so 'file_scoped:suggestion'
# silently disabled the IDE0161 enforcement in .globalconfig.
# =============================================================================

# --- Namespaces ---
# File-scoped namespaces: one less level of indentation, and the modern
# default for new C#. The codebase is converted to this style wholesale.
csharp_style_namespace_declarations = file_scoped

# --- 'var' is the preferred style ---
# Prefer 'var' so the IDE steers new code towards it. Not enforced (IDE0007
# stays at suggestion): existing code still has a few thousand explicit
# declarations, mostly built-in types such as 'int x = ...'.
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true

# --- Primary constructors ---
# NAudio does not use primary constructors: many types are interop/POCO
# shapes where explicit fields and constructors read more clearly. Don't
# nudge contributors towards them.
csharp_style_prefer_primary_constructors = false

# --- goto labels ---
# Leave goto-label indentation as written rather than enforcing a style.
# Pinned explicitly because SDK/analyzer versions disagree on the default:
# a label sitting at its surrounding indent passed a local build but failed
# CI under the enforced IDE0055. The codebase has a single label (the ported
# WdlResampler), so 'no_change' keeps it with its code instead of fighting it.
csharp_indent_labels = no_change
