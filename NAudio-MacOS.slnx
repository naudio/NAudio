<!--
    Provides the required and any supported projects for macOS development with Visual Studio code. 
    Sync changes that are happening in baseline NAudio.slnx file with the items declared here.
    Any other OS'es projects and unrelated support should not belong in this solution file.
-->

<Solution>
    <Folder Name="/Solution Items/">
        <File Path="LICENSE" />
        <File Path="README.md" />
        <File Path="readme.txt" />
        <File Path=".editorconfig" />
        <File Path="naudio-logo.png" />
        <File Path="RELEASE_NOTES.md" />
        <File Path="Docs/Architecture/MODERNIZATION.md" />
    </Folder>
    <!-- Normal projects should be after this line -->
    <Project Path="src/NAudio.Core/NAudio.Core.csproj" />
    <Project Path="src/NAudio.MacOS/NAudio.MacOS.csproj" />
    <Project Path="src/NAudio.SoundFile/NAudio.SoundFile.csproj" />
    <!-- Test projects should be after this line -->
    <Project Path="tests/NAudio.Core.Tests/NAudio.Core.Tests.csproj" />
    <Project Path="tests/NAudio.SoundFile.Tests/NAudio.SoundFile.Tests.csproj" />
</Solution>