<UserControl x:Class="NAudioWpfDemo.WasapiRecorderDemo.WasapiRecorderDemoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NAudioWpfDemo.WasapiRecorderDemo"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="760">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Readout">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="8,4,8,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="110" />
        </Grid.RowDefinitions>

        <!-- Source: each option maps to a different WasapiRecorderBuilder entry point -->
        <GroupBox Grid.Row="0" Header="Source" IsEnabled="{Binding CanEditOptions}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Capture from" />
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left" Width="260"
                          ItemsSource="{Binding CaptureSources}" DisplayMemberPath="Name" SelectedValuePath="Value"
                          SelectedValue="{Binding CaptureSource, Mode=TwoWay}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Device"
                           Visibility="{Binding ShowDevicePicker, Converter={StaticResource BoolToVis}}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                          ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          Visibility="{Binding ShowDevicePicker, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Process"
                           Visibility="{Binding ShowProcessPicker, Converter={StaticResource BoolToVis}}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                          ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                          Visibility="{Binding ShowProcessPicker, Converter={StaticResource BoolToVis}}"
                          ToolTip="Per-process loopback needs Windows 10 2004 (build 19041) or later" />
            </Grid>
        </GroupBox>

        <!-- Stream options: all of these are baked in when the recorder is built -->
        <GroupBox Grid.Row="1" Header="Stream options" IsEnabled="{Binding CanEditOptions}">
            <StackPanel>
                <WrapPanel Margin="0,3">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Share mode" />
                    <ComboBox Width="100" Margin="0,0,16,0" SelectedIndex="{Binding ShareModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Shared" />
                        <ComboBoxItem Content="Exclusive" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sync" />
                    <ComboBox Width="100" Margin="0,0,16,0" SelectedIndex="{Binding SyncModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Event" />
                        <ComboBoxItem Content="Polling" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Buffer (ms)" />
                    <TextBox Width="60" VerticalAlignment="Center" Text="{Binding BufferMilliseconds, Mode=TwoWay}" />
                </WrapPanel>

                <WrapPanel Margin="0,6,0,3">
                    <CheckBox Content="Low latency" IsChecked="{Binding UseLowLatency, Mode=TwoWay}"
                              ToolTip="Request IAudioClient3 low-latency shared mode. Needs the device mix format, shared mode and event sync." />
                    <CheckBox Content="…required" IsChecked="{Binding RequireLowLatency, Mode=TwoWay}"
                              IsEnabled="{Binding UseLowLatency}"
                              ToolTip="Throw instead of silently falling back to standard shared mode" />
                    <CheckBox Content="Raw mode" IsChecked="{Binding UseRawMode, Mode=TwoWay}"
                              ToolTip="Bypass the system capture effects (APO pipeline)" />
                    <CheckBox Content="Communications" IsChecked="{Binding UseCommunicationsMode, Mode=TwoWay}"
                              ToolTip="Request the AEC / noise suppression / AGC pipeline. Mutually exclusive with raw mode." />
                    <CheckBox Content="MMCSS priority" IsChecked="{Binding UseMmcss, Mode=TwoWay}"
                              ToolTip="Elevate the capture thread via MMCSS 'Pro Audio'" />
                </WrapPanel>

                <WrapPanel Margin="0,3">
                    <CheckBox Content="Custom format" IsChecked="{Binding UseCustomFormat, Mode=TwoWay}"
                              ToolTip="Unchecked captures at the device mix format — which is what low latency requires" />
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding UseCustomFormat}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Rate" />
                        <TextBox Width="60" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding SampleRate, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Channels" />
                        <TextBox Width="40" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding ChannelCount, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Type" />
                        <ComboBox Width="100" Margin="0,0,12,0" SelectedIndex="{Binding SampleTypeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="IEEE Float" />
                            <ComboBoxItem Content="PCM" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Bits" />
                        <TextBox Width="40" VerticalAlignment="Center" Text="{Binding BitDepth, Mode=TwoWay}"
                                 IsEnabled="{Binding IsBitDepthConfigurable}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!-- Transport, live meter, and what the recorder actually negotiated -->
        <GroupBox Grid.Row="2" Header="Transport">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Monitor" Command="{Binding MonitorCommand}" Width="80" Margin="0,0,6,0"
                            ToolTip="Run the recorder and meter the input without writing anything to disk" />
                    <Button Content="Record" Command="{Binding RecordCommand}" Width="80" Margin="0,0,6,0"
                            ToolTip="Start recording to a WAV file — or arm the file writer while already monitoring" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Width="80" Margin="0,0,16,0" />
                    <TextBlock Style="{StaticResource Readout}" Text="{Binding Status}" />
                    <TextBlock Style="{StaticResource Readout}" Margin="8,0,0,0" Foreground="Firebrick"
                               Text="● writing to file"
                               Visibility="{Binding IsWriting, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Level" />
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- ProgressBar.Value binds TwoWay by default, which a read-only source rejects -->
                    <ProgressBar Grid.Column="0" Height="18" Minimum="0" Maximum="1" Value="{Binding MeterValue, Mode=OneWay}"
                                 ToolTip="Peak level of the audio arriving from WasapiRecorder (-60..0 dBFS)" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Readout}" Margin="8,0" MinWidth="180"
                               Text="{Binding PeakText}" />
                    <Button Grid.Column="2" Content="Reset" Width="60" Command="{Binding ResetPeakCommand}"
                            ToolTip="Clear the peak-hold reading" />
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Format" Margin="0,4,6,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Readout}" Margin="0,4,0,0"
                           Text="{Binding ActualFormatText}" ToolTip="The format the recorder actually opened" />

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Latency" Margin="0,2,6,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Readout}" Margin="0,2,0,0"
                           Text="{Binding LatencyText}" />

                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="DarkOrange"
                           Text="{Binding LowLatencyText}"
                           Visibility="{Binding HasLowLatencyText, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Recordings">
            <local:RecordingsView DataContext="{Binding RecordingsViewModel}" />
        </GroupBox>
    </Grid>
</UserControl>
