<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net9.0: everything here is P/Invoke or COM interop, which compiles on
         any platform. Windows-only usage is enforced by the assembly-level
         [SupportedOSPlatform("windows")] attribute below (the NAudio.Wasapi model),
         so cross-platform projects can reference the package and plain netX.0
         consumers on Windows can use it. -->
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <Description>ASIO driver support for the NAudio audio library — low-latency multichannel playback and capture via ASIO SDK.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NAudio.Core\NAudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NAudio.Windows.Tests, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
