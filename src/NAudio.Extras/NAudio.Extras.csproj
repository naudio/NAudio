<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net9.0. The NAudio meta-package carries the Windows backends on every leg,
         so the Windows-only AudioPlaybackEngine compiles here and is marked
         [SupportedOSPlatform("windows")] rather than gated behind a Windows TFM. -->
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <Description>Optional extras (extra demo/sample providers and helpers) for the NAudio audio library.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NAudio.Core\NAudio.Core.csproj" />
    <ProjectReference Include="..\NAudio\NAudio.csproj" />
  </ItemGroup>

</Project>
