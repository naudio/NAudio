<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net9.0: everything here is P/Invoke or COM interop, which compiles on
         any platform. Windows-only usage is enforced by the assembly-level
         [SupportedOSPlatform("windows")] attribute below (the NAudio.Wasapi model),
         so cross-platform projects can reference the package and plain netX.0
         consumers on Windows can use it. -->
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <Description>VST 3® plug-in hosting for NAudio. Discover, load, and host VST 3 audio effects and instruments. VST is a registered trademark of Steinberg Media Technologies GmbH.</Description>
    <PackageTags>$(PackageTags) vst vst3 plugin host</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NAudio.Core\NAudio.Core.csproj" />
    <ProjectReference Include="..\NAudio.Midi\NAudio.Midi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
