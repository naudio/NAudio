<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net9.0: the WASAPI/CoreAudio and Media Foundation layers are all
         COM interop ([GeneratedComInterface]) and P/Invoke, which compile on any
         platform. Windows-only usage is enforced at runtime/analysis time by the
         assembly-level [SupportedOSPlatform("windows")] attribute below (the same
         model as NAudio.Alsa). This lets cross-platform apps reference the package
         and build on Linux/macOS without EnableWindowsTargeting. The WinRT MIDI
         backend, which needed the versioned Windows TFM, now lives in NAudio.Midi. -->
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>WASAPI playback and capture (including loopback and process loopback) and Media Foundation codecs for the NAudio audio library. Windows-only at runtime.</Description>
  </PropertyGroup>

  <!-- needed for perfomance profiling unit tests -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	<DebugType>full</DebugType>
	<DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NAudio.Core\NAudio.Core.csproj" />
    <!-- NAudio.Midi reference dropped: WinRT MIDI (its only consumer here) moved
         to NAudio.Midi. Keeping Wasapi off Midi avoids transitively pulling Midi's
         multi-target (Windows) graph into cross-platform Wasapi consumers. -->
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
    <!-- Grants the test project access to internal helpers (e.g. WasapiFormatAdaptation).
         Strong-named, so the friend name + public key must stay in sync with the test assembly. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NAudio.Windows.Tests, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  </Project>
