<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Single plain net9.0 target. The meta-package carries Core and Midi plus exactly
         the Windows backends its own types need: WinMM (ACM, used by Mp3FileReader and by
         AudioFileReader for compressed WAV) and Wasapi (Media Foundation, used by
         AudioFileReader). Both are plain net9.0, Windows-only via [SupportedOSPlatform],
         so a plain netX.0 project on Windows gets them. Mp3FileReader is marked
         Windows-only, and AudioFileReader picks its Media Foundation/ACM paths with
         OperatingSystem.IsWindows() at runtime.
         NAudio.Asio, NAudio.Dmo and NAudio.WinForms are not included: nothing here uses
         them, and consumers reference them directly. Leaving WinForms out is also what
         removes the need for a Windows TFM leg, and with it the class of silent
         fallback bugs that legs caused (#1407, #1472). -->
    <TargetFramework>net9.0</TargetFramework>
    <Authors>Mark Heath &amp; Contributors</Authors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>NAudio is an open source .NET audio library — playback and recording, file readers and writers, MIDI, DSP and effects, plus the core Windows audio backends (WASAPI, Media Foundation and WinMM). ASIO, DMO/DirectSound and WinForms support are separate packages.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NAudio.Core\NAudio.Core.csproj" />
    <ProjectReference Include="..\NAudio.Midi\NAudio.Midi.csproj" />
    <ProjectReference Include="..\NAudio.WinMM\NAudio.WinMM.csproj" />
    <ProjectReference Include="..\NAudio.Wasapi\NAudio.Wasapi.csproj" />
  </ItemGroup>

</Project>
