<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Two legs that differ only in their dependencies, not in code: NAudio.dll is
         identical in both. The Windows backends (Asio, Dmo, WinMM, Wasapi) are plain
         net9.0, Windows-only via [SupportedOSPlatform], so every leg carries them and a
         plain netX.0 project on Windows gets the full stack. Mp3FileReader is marked
         Windows-only, and AudioFileReader picks its Media Foundation/ACM paths with
         OperatingSystem.IsWindows() at runtime rather than #if.
         The net9.0-windows leg exists only to add NAudio.WinForms, which needs a Windows
         TFM. It is deliberately the plain (version 7.0) Windows TFM, so template-default
         netX.0-windows projects resolve it (#1407). No versioned leg is needed:
         NAudio.Midi's WinRT MIDI asset is chosen by the consumer's own TFM, whichever
         NAudio leg they land on. -->
    <!-- During docs generation (DocsBuild=true) collapse to a single TFM, because DocFX
         cannot read a multi-targeted project. net9.0 is the right leg: it has the same
         API as the Windows leg, and NAudio.Extras (plain net9.0) references this project.
         NAudio.WinForms is documented from its own project. -->
    <TargetFrameworks Condition=" '$(DocsBuild)' != 'true' ">net9.0;net9.0-windows</TargetFrameworks>
    <TargetFramework Condition=" '$(DocsBuild)' == 'true' ">net9.0</TargetFramework>
    <Authors>Mark Heath &amp; Contributors</Authors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>NAudio is an open source .NET audio library — playback and recording, file readers and writers, MIDI, DSP and effects, with the Windows audio backends (WASAPI, Media Foundation, WinMM, ASIO, DMO) included.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NAudio.Core\NAudio.Core.csproj" />
    <ProjectReference Include="..\NAudio.Midi\NAudio.Midi.csproj" />
    <ProjectReference Include="..\NAudio.Asio\NAudio.Asio.csproj" />
    <ProjectReference Include="..\NAudio.Dmo\NAudio.Dmo.csproj" />
    <ProjectReference Include="..\NAudio.WinMM\NAudio.WinMM.csproj" />
    <ProjectReference Include="..\NAudio.Wasapi\NAudio.Wasapi.csproj" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetPlatformIdentifier)' == 'windows' ">
    <ProjectReference Include="..\NAudio.WinForms\NAudio.WinForms.csproj" />
  </ItemGroup>

</Project>
